def expand_in_file(filepath):
    """Find and replace snippet codes in a file"""
    with open(filepath) as f:
        content = f.read()

    original = content
    for code, expansion in SNIPPETS.items():
        # Match the code as a standalone word (not inside a string/comment)
        pattern = r'\b' + re.escape(code) + r'\b'
        if re.search(pattern, content):
            content = re.sub(pattern, expansion, content)
            print(f"  Expanded: {code}")

    if content != original:
        with open(filepath, 'w') as f:
            f.write(content)
        return True
    return False

