    if not os.path.exists(filepath):
        print(f"File not found: {filepath}")
        sys.exit(1)

    print(f"Expanding snippets in {filepath}...")
    if expand_in_file(filepath):
        print("Done!")
    else:
        print("No snippets found to expand")

if __name__ == '__main__':
