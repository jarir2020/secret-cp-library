const int INF = 1e9+5;
const i64 LINF = 1e18;

void solve() {
    // Your code here
}

int main() {
    ios::sync_with_stdio(false); cin.tie(0);
    int t; cin >> t;
    while (t--) solve();
}
TEMPLATE
fi

# Create input.txt placeholder
touch "$DIR/input.txt"

echo "Created: $FILE (style $STYLE)"
echo "Input:   $DIR/input.txt"
echo ""
echo "Run:  cd $DIR && g++ -O2 -o sol $PROBLEM.cpp && ./sol < input.txt"
